{
  "version": 4,
  "terraform_version": "1.7.5",
  "serial": 42,
  "lineage": "a1b2c3d4-shopflow-prod",
  "outputs": {},
  "resources": [
    {
      "mode": "managed",
      "type": "google_sql_database_instance",
      "name": "orders_db",
      "provider": "provider[\"registry.terraform.io/hashicorp/google\"]",
      "instances": [
        {
          "attributes": {
            "name": "prod-orders-db",
            "database_version": "POSTGRES_15",
            "region": "us-east1",
            "settings": {
              "tier": "db-n1-standard-8",
              "availability_type": "ZONAL",
              "disk_size": 100,
              "disk_autoresize": true,
              "backup_configuration": {
                "enabled": true,
                "point_in_time_recovery_enabled": false,
                "backup_retention_settings": { "retained_backups": 2 }
              },
              "ip_configuration": {
                "ipv4_enabled": true,
                "require_ssl": false,
                "authorized_networks": [{ "name": "office", "value": "0.0.0.0/0" }]
              }
            }
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_container_cluster",
      "name": "app_cluster",
      "provider": "provider[\"registry.terraform.io/hashicorp/google\"]",
      "instances": [
        {
          "attributes": {
            "name": "prod-app-cluster",
            "location": "us-east1-b",
            "node_locations": ["us-east1-b"],
            "initial_node_count": 3,
            "private_cluster_config": { "enable_private_nodes": false, "enable_private_endpoint": false },
            "workload_identity_config": [],
            "release_channel": { "channel": "UNSPECIFIED" },
            "cluster_autoscaling": { "enabled": true, "min_node_count": 1, "max_node_count": 5 }
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_cloud_run_service",
      "name": "checkout_api",
      "provider": "provider[\"registry.terraform.io/hashicorp/google\"]",
      "instances": [
        {
          "attributes": {
            "name": "prod-checkout-api",
            "location": "us-east1",
            "template": {
              "metadata": {
                "annotations": {
                  "autoscaling.knative.dev/minScale": "0",
                  "autoscaling.knative.dev/maxScale": "100"
                }
              },
              "spec": { "container_concurrency": 80, "timeout_seconds": 300 }
            }
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_storage_bucket",
      "name": "product_images",
      "provider": "provider[\"registry.terraform.io/hashicorp/google\"]",
      "instances": [
        {
          "attributes": {
            "name": "prod-product-images",
            "location": "US",
            "storage_class": "STANDARD",
            "uniform_bucket_level_access": false,
            "versioning": { "enabled": false },
            "public_access_prevention": "inherited"
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_storage_bucket",
      "name": "db_backups",
      "provider": "provider[\"registry.terraform.io/hashicorp/google\"]",
      "instances": [
        {
          "attributes": {
            "name": "prod-db-backups",
            "location": "us-east1",
            "storage_class": "NEARLINE",
            "uniform_bucket_level_access": true,
            "versioning": { "enabled": true },
            "lifecycle_rule": [
              { "action": { "type": "Delete" }, "condition": { "age": 365 } }
            ]
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_pubsub_topic",
      "name": "order_events",
      "provider": "provider[\"registry.terraform.io/hashicorp/google\"]",
      "instances": [
        { "attributes": { "name": "prod-order-events" } }
      ]
    },
    {
      "mode": "managed",
      "type": "google_pubsub_subscription",
      "name": "order_events_worker",
      "provider": "provider[\"registry.terraform.io/hashicorp/google\"]",
      "instances": [
        {
          "attributes": {
            "name": "prod-order-events-worker",
            "topic": "prod-order-events",
            "ack_deadline_seconds": 10,
            "retry_policy": [],
            "dead_letter_policy": []
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_bigquery_dataset",
      "name": "analytics",
      "provider": "provider[\"registry.terraform.io/hashicorp/google\"]",
      "instances": [
        {
          "attributes": {
            "dataset_id": "prod_analytics",
            "location": "US",
            "delete_contents_on_destroy": true,
            "default_table_expiration_ms": null
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_compute_firewall",
      "name": "allow_rdp",
      "provider": "provider[\"registry.terraform.io/hashicorp/google\"]",
      "instances": [
        {
          "attributes": {
            "name": "prod-allow-rdp",
            "network": "default",
            "direction": "INGRESS",
            "source_ranges": ["0.0.0.0/0"],
            "allow": [{ "protocol": "tcp", "ports": ["3389"] }]
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_compute_instance",
      "name": "legacy_worker",
      "provider": "provider[\"registry.terraform.io/hashicorp/google\"]",
      "instances": [
        {
          "attributes": {
            "name": "prod-legacy-worker",
            "machine_type": "n1-standard-4",
            "zone": "us-east1-b",
            "scheduling": { "preemptible": false, "automatic_restart": true }
          }
        }
      ]
    },
    {
      "mode": "managed",
      "type": "google_service_account",
      "name": "ci_sa",
      "provider": "provider[\"registry.terraform.io/hashicorp/google\"]",
      "instances": [
        { "attributes": { "account_id": "prod-ci-sa", "display_name": "CI/CD service account" } }
      ]
    },
    {
      "mode": "managed",
      "type": "google_project_iam_binding",
      "name": "ci_owner",
      "provider": "provider[\"registry.terraform.io/hashicorp/google\"]",
      "instances": [
        {
          "attributes": {
            "role": "roles/owner",
            "members": ["serviceAccount:prod-ci-sa@shopflow.iam.gserviceaccount.com"]
          }
        }
      ]
    }
  ]
}
